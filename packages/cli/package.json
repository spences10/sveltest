{
	"name": "sveltest",
	"version": "0.0.8",
	"description": "CLI tool to fetch Svelte testing patterns and examples from sveltest.dev",
	"keywords": [
		"cli",
		"playwright",
		"svelte",
		"sveltest",
		"testing",
		"vitest"
	],
	"homepage": "https://sveltest.dev",
	"bugs": {
		"url": "https://github.com/spences10/sveltest/issues"
	},
	"license": "MIT",
	"author": "Scott Spence",
	"repository": {
		"type": "git",
		"url": "https://github.com/spences10/sveltest.git",
		"directory": "packages/cli"
	},
	"bin": {
		"sveltest": "./bin/sveltest.js"
	},
	"files": [
		"dist",
		"bin",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"test": "vp test",
		"test:watch": "vp test watch",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"citty": "^0.2.2"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
