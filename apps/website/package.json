{
	"name": "@sveltest/website",
	"version": "0.0.2",
	"private": true,
	"homepage": "https://github.com/spences10/sveltest",
	"bugs": {
		"url": "https://github.com/spences10/sveltest/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/spences10/sveltest.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"lint:fix": "vp check --fix",
		"test:unit": "vp test",
		"test:server": "vp test --project=server",
		"test:client": "vp test --project=client",
		"test:ssr": "vp test --project=ssr",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"coverage": "vp test --run --coverage"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/victor-mono": "^5.3.0",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"@vitest/browser": "^5.0.0",
		"@vitest/browser-playwright": "^5.0.0",
		"@vitest/coverage-v8": "^5.0.0",
		"daisyui": "^5.7.22",
		"fathom-client": "^3.7.2",
		"jsdom": "^30.0.1",
		"mdsvex": "^0.12.8",
		"playwright": "catalog:",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.4.3",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "^8.2.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^3.0.0",
		"zod": "catalog:"
	}
}
